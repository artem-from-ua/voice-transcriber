    {"start": 121.0, "end": 130.0, "content": "Читав статтю про проблеми з наркотиками у Португалії.", "speaker": "SPEAKER_01", "name": "Остап"},
    {"start": 131.0, "end": 138.0, "content": "Цікавий підхід до декриміналізації.", "speaker": "SPEAKER_00", "name": "Артем"},
